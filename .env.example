# Variables de entorno opcionales (ninguna es obligatoria; el proyecto corre sin este archivo).
# Para usarlas: copia este archivo a ".env" y ajusta los valores.

# Puerto del servidor de vista previa (npm run preview). Por defecto: 4300.
PORT=4300

# Ruta al ejecutable de Chrome/Chromium, usada por la auditoría de accesibilidad (npm run a11y).
# Déjala vacía para que Playwright use su Chromium por defecto.
CHROME_PATH=
